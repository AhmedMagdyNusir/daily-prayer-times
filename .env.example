# Copy this file to .env and adjust the values.
# Vite reads these at build time: rebuild/redeploy after changing them.

# Summer time (DST) handling. Adds one hour to all prayer times when active.
#   auto - follow Egypt's rule (last Friday of April -> last Thursday of October)
#   on   - always add one hour
#   off  - never add one hour
VITE_DST_MODE=auto

# Shift the Hijri date by whole days (-2..2) when the local moon sighting
# differs from the calendar returned by the Aladhan API. Default: 0
VITE_HIJRI_ADJUSTMENT=0
